# =========================================================
# Local Environment Variables Example (.env)
# Copy this file to .env: cp .env.example .env
# =========================================================

# PostgreSQL Configuration
POSTGRES_USER=kanban_user
POSTGRES_PASSWORD=kanban_password
POSTGRES_DB=kanban_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URL
DATABASE_URL=postgresql://kanban_user:kanban_password@db:5432/kanban_db

# Application Settings
BACKEND_PORT=8000
FRONTEND_PORT=3000
APP_ENV=development
